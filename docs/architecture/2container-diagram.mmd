%%{init: {'theme': 'base', 'themeVariables': { 'background': '#ffffff', 'primaryColor': '#ffffff', 'primaryTextColor': '#000000', 'primaryBorderColor': '#000000', 'lineColor': '#000000', 'textColor': '#000000', 'boundaryBkgColor': '#ffffff', 'boundaryBorderColor': '#000000', 'boundaryTextColor': '#000000', 'personBorder': '#000000', 'personBkg': '#ffffff' }, 'themeCSS': '.messageText { fill: #000000 !important; font-size: 16px !important; font-weight: 700 !important; } .messageLine0, .messageLine1 { stroke: #000000 !important; }'}}%%
C4Container
    title Container diagram for Training Ground

    Person(student, "Student", "Practices writing and evaluating user stories and acceptance criteria")
    Person(instructor, "Instructor", "Authors content, manages courses, and reviews student performance")

    System_Boundary(trainingGround, "Training Ground") {
        Container(webApp, "Web Application", "Next.js App Router, React", "Renders role-gated pages; caches non-sensitive state in the browser")
        Container(apiApp, "API Application", "Next.js API Routes (Node, serverless)", "Enforces auth and ownership, applies scoring/session rules, talks to all external systems")
    }

    System_Boundary(supabase, "Supabase Platform") {
        ContainerDb(database, "Database", "PostgreSQL", "Stores users, courses, catalogs, questions, sessions, submissions, scores")
        Container(authService, "Auth Service", "Supabase Auth", "Issues and refreshes JWT access tokens; creates accounts")
        Container(storageService, "Storage Service", "Supabase Storage", "Public buckets for avatar and course-cover images")
    }

    System_Ext(llmProvider, "LLM Provider", "Claude, ChatGPT, or Gemini - one active provider per instructor")

    Rel(student, webApp, "Uses", "HTTPS")
    Rel(instructor, webApp, "Uses", "HTTPS")
    Rel(webApp, apiApp, "Calls", "JSON/HTTPS, Bearer JWT")
    Rel(apiApp, database, "Reads from and writes to", "Service-role client")
    Rel(apiApp, authService, "Verifies tokens; logs in, refreshes, and registers users via", "Supabase Admin & Auth API")
    Rel(apiApp, storageService, "Uploads and serves images via", "Supabase Storage API")
    Rel(apiApp, llmProvider, "Requests free-text grading from", "HTTPS, per-instructor encrypted API key")

    UpdateLayoutConfig($c4ShapeInRow="3", $c4BoundaryInRow="1")

    UpdateElementStyle(student, $bgColor="#ffffff", $fontColor="#000000", $borderColor="#000000")
    UpdateElementStyle(instructor, $bgColor="#ffffff", $fontColor="#000000", $borderColor="#000000")
    UpdateElementStyle(webApp, $bgColor="#ffffff", $fontColor="#000000", $borderColor="#000000")
    UpdateElementStyle(apiApp, $bgColor="#ffffff", $fontColor="#000000", $borderColor="#000000")
    UpdateElementStyle(database, $bgColor="#ffffff", $fontColor="#000000", $borderColor="#000000")
    UpdateElementStyle(authService, $bgColor="#ffffff", $fontColor="#000000", $borderColor="#000000")
    UpdateElementStyle(storageService, $bgColor="#ffffff", $fontColor="#000000", $borderColor="#000000")
    UpdateElementStyle(llmProvider, $bgColor="#ffffff", $fontColor="#000000", $borderColor="#000000")
